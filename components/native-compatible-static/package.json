{
  "name": "@shader-bench/native-compatible-static",
  "version": "0.1.0",
  "description": "<Effect> shader component: raw WebGL 1 on the web, own Fabric component on React Native >= 0.81 with shaders shipped natively (Metal precompiled to a metallib on iOS, GLSL packaged as an Android asset for OpenGL ES 2.0)",
  "license": "MIT",
  "private": true,
  "main": "src/Effect.web.tsx",
  "browser": "src/Effect.web.tsx",
  "react-native": "src/Effect.native.tsx",
  "types": "src/Effect.web.tsx",
  "exports": {
    ".": {
      "react-native": "./src/Effect.native.tsx",
      "browser": "./src/Effect.web.tsx",
      "types": "./src/Effect.web.tsx",
      "default": "./src/Effect.web.tsx"
    },
    "./shaders": "./src/schema.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ios",
    "android/build.gradle",
    "android/src",
    "ShaderBenchCompatStatic.podspec",
    "README.md"
  ],
  "sideEffects": [
    "./src/shaders/index.ts"
  ],
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "ShaderBenchCompatStaticSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.shaderbench.compatstatic"
    },
    "ios": {
      "componentProvider": {
        "ShaderBenchCompatStaticView": "ShaderBenchCompatStaticView"
      }
    }
  }
}
